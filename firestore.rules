rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permet la lecture et l'écriture pour les parcelles synchronisées et notes d'équipe
    match /parcelles/{parcelId} {
      allow read, write: if true;
    }
    match /custom_parcelles/{parcelId} {
      allow read, write: if true;
    }
    match /overrides/{overrideId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
